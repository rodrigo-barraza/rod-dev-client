    "@vercel/analytics": "^2.0.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.31.0",
    "luxon": "^3.7.2",
    "mitt": "^3.0.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
